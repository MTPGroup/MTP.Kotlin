<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- Console Pattern (logback built-in colors only, no custom converter) -->
    <!-- highlight: ERROR=bold-red, WARN=red, INFO=blue, DEBUG=default -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%green(%d{HH:mm:ss}) %highlight(%-5level) %cyan(%-38.38logger{35}) %msg%n"/>

    <!-- Console Appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File Appender (no color) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/azusa.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/azusa.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%15.15thread] %-40.40logger{39} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Root -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <!--<appender-ref ref="FILE"/>-->
    </root>

    <logger name="tech.hanasaki.azusa" level="DEBUG"/>

    <!-- Framework loggers -->
    <logger name="org.eclipse.jetty" level="INFO"/>
    <!-- Exposed SQL logging -->
    <!--<logger name="Exposed" level="DEBUG"/>-->
</configuration>
