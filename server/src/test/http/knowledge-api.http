@baseUrl = http://localhost:8080
@email = user@example.com
@password = password123

### 1. 用户登录（获取 Token）
POST {{baseUrl}}/auth/sign-in/email
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set("accessToken", response.body.data.accessToken);
    client.log("Access Token captured");
%}

### ========== Knowledge Base 模块 ==========

### 2.1 创建知识库
POST {{baseUrl}}/knowledge-bases
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "测试知识库",
  "description": "这是一个用于测试的知识库",
  "isPublic": false
}

> {%
    client.global.set("knowledgeBaseId", response.body.data.id);
    client.log("Knowledge base created: " + response.body.data.id);
%}

### 2.2 获取我的知识库列表（分页）
GET {{baseUrl}}/knowledge-bases?page=1&limit=10
Authorization: Bearer {{accessToken}}

### 2.3 获取公开知识库列表
GET {{baseUrl}}/knowledge-bases/public?page=1&limit=10

### 2.4 搜索公开知识库
GET {{baseUrl}}/knowledge-bases/search?q=测试&page=1&limit=10

### 2.5 获取知识库详情
GET {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}
Authorization: Bearer {{accessToken}}

### 2.6 更新知识库
PUT {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "更新后的知识库",
  "description": "更新后的描述",
  "isPublic": true
}

### 2.7 获取知识库统计信息
GET {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/stats
Authorization: Bearer {{accessToken}}

### ========== 文件管理 ==========

### 3.1 上传文件到知识库
POST {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/files
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fileName": "test-document.pdf",
  "filePath": "uploads/test-document.pdf",
  "fileSize": 102400,
  "fileType": "application/pdf"
}

> {%
    client.global.set("fileId", response.body.data.id);
    client.log("File uploaded: " + response.body.data.id);
%}

### 3.2 获取知识库的文件列表
GET {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/files
Authorization: Bearer {{accessToken}}

### 3.3 获取文件详情
GET {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/files/{{fileId}}
Authorization: Bearer {{accessToken}}

### 3.4 重试失败的文件处理
POST {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/files/{{fileId}}/retry
Authorization: Bearer {{accessToken}}

### 3.5 删除文件
DELETE {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/files/{{fileId}}
Authorization: Bearer {{accessToken}}

### ========== 知识检索 ==========

### 4.1 搜索单个知识库
POST {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}/search
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "query": "如何使用这个功能？",
  "threshold": 0.7,
  "limit": 5
}

### 4.2 搜索我的所有知识库
POST {{baseUrl}}/knowledge/search
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "query": "如何使用这个功能？",
  "threshold": 0.7,
  "limit": 10
}

### 4.3 搜索指定的多个知识库
POST {{baseUrl}}/knowledge/search
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "query": "如何使用这个功能？",
  "knowledgeBaseIds": ["{{knowledgeBaseId}}"],
  "threshold": 0.7,
  "limit": 10
}

### 4.4 搜索公开知识库
POST {{baseUrl}}/knowledge/search/public
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "query": "如何使用这个功能？",
  "threshold": 0.7,
  "limit": 10
}

### ========== 清理 ==========

### 5.1 删除知识库
DELETE {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}
Authorization: Bearer {{accessToken}}

### 5.2 验证删除（应该返回 404）
GET {{baseUrl}}/knowledge-bases/{{knowledgeBaseId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Knowledge base should be deleted", function () {
        client.assert(response.status === 404, "Should return 404");
    });
%}
