@baseUrl = http://localhost:8080
@email = user@example.com
@password = password123
@adminEmail = admin@example.com
@adminPassword = admin123

### 1. 用户登录（获取 Token）
POST {{baseUrl}}/auth/sign-in/email
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set("accessToken", response.body.data.accessToken);
    client.log("User Access Token captured");
%}

### 1.1 管理员登录（用于审批）
POST {{baseUrl}}/auth/sign-in/email
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminToken", response.body.data.accessToken);
    client.log("Admin Access Token captured");
%}

### ========== Plugin 模块 ==========

### 2.1 创建插件
POST {{baseUrl}}/plugins
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "weather-plugin",
  "description": "获取天气信息的插件",
  "version": "1.0.0",
  "schema": {
    "name": "get_weather",
    "description": "Get current weather for a city",
    "parameters": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "description": "City name"
        }
      },
      "required": ["city"]
    }
  },
  "code": "fun execute(params: Map<String, Any>): String { return \"Weather data\" }"
}

> {%
    client.global.set("pluginId", response.body.data.id);
    client.log("Plugin created: " + response.body.data.id);
%}

### 2.2 获取我创建的插件列表
GET {{baseUrl}}/me/plugins?page=1&limit=10
Authorization: Bearer {{accessToken}}

### 2.3 获取公开插件列表（分页）
GET {{baseUrl}}/plugins?page=1&limit=10

### 2.4 搜索插件
GET {{baseUrl}}/plugins/search?q=weather&page=1&limit=10

### 2.5 获取插件详情
GET {{baseUrl}}/plugins/{{pluginId}}
Authorization: Bearer {{accessToken}}

### 2.6 更新插件
PUT {{baseUrl}}/plugins/{{pluginId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "weather-plugin-v2",
  "description": "获取天气信息的插件（更新版）",
  "version": "2.0.0",
  "schema": {
    "name": "get_weather",
    "description": "Get current weather for a city with more options",
    "parameters": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "description": "City name"
        },
        "unit": {
          "type": "string",
          "enum": ["celsius", "fahrenheit"],
          "description": "Temperature unit"
        }
      },
      "required": ["city"]
    }
  },
  "code": "fun execute(params: Map<String, Any>): String { return \"Weather data v2\" }"
}

### ========== 审批流程（管理员） ==========

### 3.1 审批通过
POST {{baseUrl}}/plugins/{{pluginId}}/approve
Authorization: Bearer {{adminToken}}

### 3.2 审批拒绝（如果需要测试拒绝流程，先创建新插件）
# POST {{baseUrl}}/plugins/{{pluginId}}/reject
# Authorization: Bearer {{adminToken}}

### ========== 订阅和点赞 ==========

### 4.1 订阅插件
POST {{baseUrl}}/plugins/{{pluginId}}/subscribe
Authorization: Bearer {{accessToken}}

### 4.2 获取我订阅的插件列表
GET {{baseUrl}}/me/plugins/subscriptions?page=1&limit=10
Authorization: Bearer {{accessToken}}

### 4.3 点赞插件
POST {{baseUrl}}/plugins/{{pluginId}}/like
Authorization: Bearer {{accessToken}}

### 4.4 取消点赞
DELETE {{baseUrl}}/plugins/{{pluginId}}/like
Authorization: Bearer {{accessToken}}

### 4.5 取消订阅
DELETE {{baseUrl}}/plugins/{{pluginId}}/subscribe
Authorization: Bearer {{accessToken}}

### ========== 清理 ==========

### 5.1 删除插件
DELETE {{baseUrl}}/plugins/{{pluginId}}
Authorization: Bearer {{accessToken}}

### 5.2 验证删除（应该返回 404）
GET {{baseUrl}}/plugins/{{pluginId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Plugin should be deleted", function () {
        client.assert(response.status === 404, "Should return 404");
    });
%}
