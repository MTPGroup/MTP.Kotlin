# =============================================================================
# Azusa Server 环境变量配置示例
# =============================================================================
# 使用方法：
#   1. 复制此文件为 .env： cp .env.example .env
#   2. 修改 .env 文件中的值为实际配置
#   3. 确保 .env 文件不提交到 Git：已在 .gitignore 中配置
# =============================================================================

# =============================================================================
# 【基础配置】
# =============================================================================

# 日志级别：DEBUG | INFO | WARN | ERROR
# DEBUG: 开发调试模式，输出详细日志
# INFO:  生产环境推荐，输出关键信息
# WARN:  仅输出警告和错误
LOG_LEVEL=INFO

# 开发模式开关：true | false
# true:  开启开发模式（错误信息更详细，部分功能简化）
# false: 生产模式（错误信息隐藏，严格校验）
DEV_MODE=false

# =============================================================================
# 【数据库配置 - PostgreSQL 14+】
# =============================================================================

# JDBC 连接地址
# 格式：jdbc:postgresql://[主机]:[端口]/[数据库名]?currentSchema=[模式]
# 示例：
#   - 本地：     jdbc:postgresql://localhost:5432/azusa?currentSchema=public,extensions
#   - Docker：   jdbc:postgresql://postgres:5432/azusa?currentSchema=public,extensions
#   - 云数据库： jdbc:postgresql://db.xxx.amazonaws.com:5432/azusa?ssl=true&currentSchema=public,extensions
DB_URL=jdbc:postgresql://localhost:5432/azusa?currentSchema=public,extensions

# 数据库用户名
DB_USER=postgres

# 数据库名（通常与连接串中一致）
DB_NAME=azusa

# 数据库密码（生产环境请使用强密码）
DB_PASSWORD=your_strong_password_here

# =============================================================================
# 【缓存配置 - Redis 7+】
# =============================================================================

# Redis 主机地址
# 本地：localhost
# Docker：redis
REDIS_HOST=localhost

# Redis 端口（默认 6379）
REDIS_PORT=6379

# Redis 密码（如无密码请留空）
REDIS_PASSWORD=your_redis_password

# =============================================================================
# 【Redis Stream 事件流配置】
# =============================================================================
# 用于跨服务事件传递（集成事件总线）

# Stream 键名
STREAM_KEY=azusa:stream:outbox-events

# 消费者组名称（多实例部署时使用同一组名）
CONSUMER_GROUP=azusa-consumers

# =============================================================================
# 【JWT 认证配置】
# =============================================================================

# JWT 签发者标识
JWT_ISSUER=azusa

# JWT 受众标识
JWT_AUDIENCE=azusa

# JWT 领域标识
JWT_REALM=azusa

# JWT 密钥（生产环境必须修改！建议 256 位随机字符串）
# 生成方法：openssl rand -base64 32
JWT_SECRET=change_this_to_a_very_long_random_secret_key_32chars_min

# 访问令牌有效期（分钟）
AUTH_ACCESS_TOKEN_MINUTES=60

# 刷新令牌有效期（天）
AUTH_REFRESH_TOKEN_DAYS=30

# =============================================================================
# 【对象存储配置 - S3 兼容服务】
# =============================================================================
# 支持：MinIO、AWS S3、阿里云 OSS、腾讯云 COS 等

# S3 服务端点
# MinIO 本地：http://localhost:9000
# MinIO Docker：http://minio:9000
# AWS S3：     https://s3.amazonaws.com
# 阿里云 OSS： https://oss-cn-hangzhou.aliyuncs.com
S3_ENDPOINT=http://localhost:9000

# S3 区域
# MinIO：us-east-1
# AWS：  实际区域如 us-west-2
# 阿里云：oss-cn-hangzhou
S3_REGION=us-east-1

# 用户头像存储桶名称
S3_AVATAR_BUCKET=azusa-avatars

# 知识库存储桶名称
S3_KNOWLEDGE_BUCKET=azusa-knowledge

# S3 访问密钥（Access Key）
S3_ACCESS_KEY=minioadmin

# S3 访问密钥（Secret Key）
S3_SECRET_KEY=minioadmin

# S3 公开访问基础 URL
# MinIO：http://localhost:9000
# AWS：  https://your-bucket.s3.amazonaws.com
S3_PUBLIC_BASE_URL=http://localhost:9000

# 强制使用路径样式（MinIO 需要设置为 true）
S3_FORCE_PATH_STYLE=true

# =============================================================================
# 【邮件服务配置 - SMTP】
# =============================================================================
# 用于发送验证码、通知邮件

# SMTP 服务器主机
# 示例：smtp.gmail.com、smtp.163.com、smtp.qq.com
SMTP_HOST=smtp.example.com

# SMTP 端口（25 | 587 | 465）
# 587：TLS 推荐
# 465：SSL
# 25：  无加密（不推荐）
SMTP_PORT=587

# SMTP 登录用户名（通常是完整邮箱地址）
SMTP_USERNAME=no-reply@example.com

# SMTP 登录密码或授权码
SMTP_PASSWORD=your_smtp_password

# 发件人显示邮箱地址
SMTP_FROM=no-reply@example.com

# 启用 TLS 加密：true | false
SMTP_TLS=true

# 是否启用邮件功能：true | false
# false：邮件功能关闭，OTP 将通过其他方式发送
SMTP_ENABLED=true

# =============================================================================
# 【OTP 验证码配置】
# =============================================================================
# 用于登录、注册、密码重置的短信/邮件验证码

# 验证码长度（默认 6 位）
OTP_LENGTH=6

# 验证码有效期（分钟）
OTP_EXPIRES_MINUTES=10

# 两次发送最小间隔（秒，防刷）
OTP_MIN_INTERVAL_SECONDS=60

# 每小时最大发送次数（防刷）
OTP_MAX_PER_HOUR=5

# 调试模式返回验证码：true | false
# ⚠️ 生产环境必须设为 false！
# true：验证码会在 API 响应中返回（仅测试使用）
OTP_DEBUG_RETURN=false

# =============================================================================
# 【LLM 大语言模型配置】
# =============================================================================
# 用于 AI 角色对话生成
# 支持：Ollama、OpenAI、Claude、Gemini 等

# LLM 提供商：ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama

# LLM 服务端点
# Ollama：http://localhost:11434
# OpenAI：https://api.openai.com/v1
LLM_ENDPOINT=http://localhost:11434

# LLM 模型名称
# Ollama：qwen3:4b、llama3.1、deepseek-r1:14b
# OpenAI：gpt-4o、gpt-4o-mini
LLM_MODEL=qwen3:4b

# LLM API 密钥（Ollama 可留空，OpenAI 必需）
LLM_API_KEY=your_api_key_here

# 生成温度（0.0-1.0），越高越随机
LLM_TEMPERATURE=0.7

# 是否返回思考过程（支持 thinking 的模型）
LLM_RETURN_THINKING=true

# =============================================================================
# 【向量嵌入模型配置】
# =============================================================================
# 用于知识库文档向量化

# 嵌入提供商：ollama | openai
EMBEDDING_PROVIDER=ollama

# 嵌入服务端点
EMBEDDING_ENDPOINT=http://localhost:11434

# 嵌入模型名称
# Ollama：bge-m3（推荐）、nomic-embed-text
# OpenAI：text-embedding-3-small
text-embedding-3-large
EMBEDDING_MODEL=bge-m3

# 嵌入 API 密钥
EMBEDDING_API_KEY=your_api_key_here

# 嵌入维度（bge-m3 是 1024，根据模型调整）
EMBEDDING_DIMENSION=1024

# =============================================================================
# 【开发环境快速配置参考】
# =============================================================================
# 使用 Docker Compose 一键启动依赖服务：
#
#   docker-compose up -d
#
# 然后使用以下配置：
#
# DB_URL=jdbc:postgresql://localhost:5434/azusa?currentSchema=public,extensions
# REDIS_HOST=localhost
# S3_ENDPOINT=http://localhost:9000
# SMTP_ENABLED=false
# OTP_DEBUG_RETURN=true
#
# =============================================================================
