# Database
DB_URL=jdbc:postgresql://localhost:5434/azusa?currentSchema=public,extensions
DB_USER=postgres
DB_NAME=azusa
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# Redis Stream
STREAM_KEY=azusa:stream:outbox-events
CONSUMER_GROUP=azusa-consumers

# JWT
JWT_ISSUER=azusa
JWT_AUDIENCE=azusa
JWT_REALM=azusa
JWT_SECRET=change_me

# Auth
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_REFRESH_TOKEN_DAYS=30

# S3 (MinIO/RustFS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_AVATAR_BUCKET=avatars
S3_KNOWLEDGE_BUCKET=knowledge-base
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=no-reply@example.com
SMTP_TLS=true
SMTP_ENABLED=true

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MIN_INTERVAL_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_DEBUG_RETURN=false

# Logging (可选)
LOG_LEVEL=INFO

# 开发模式 (可选)
DEV_MODE=false
