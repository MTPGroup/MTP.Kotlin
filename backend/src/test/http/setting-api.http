@baseUrl = http://localhost:8080
@email = user@example.com
@password = password123

### 1.1 用户登录
POST {{baseUrl}}/auth/sign-in/email
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
    client.log("Access Token captured");
%}


### 2.1 获取当前用户设置
GET {{baseUrl}}/settings
Authorization: Bearer {{accessToken}}

> {%
    client.global.set("userId", response.body.uid);
    client.global.set("createdAt", response.body.createdAt);
    client.log("Captured User ID: " + response.body.uid);
%}

### 2.2 更新设置 (修改主题为 DARK)
PUT {{baseUrl}}/settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "uid": "{{userId}}",
  "theme": "DARK",
  "activeThemeId": null,
  "activeLlmConfigId": "3e364a23-7983-4f4e-8836-406cb03e9bda",
  "llmConfigs": [
    {
      "id": "3e364a23-7983-4f4e-8836-406cb03e9bda",
      "provider": "OPENAI",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "sk-test-key-updated",
      "model": "gpt-4-turbo",
      "temperature": 0.8,
      "maxTokens": 4096,
      "runOnClient": false
    }
  ],
  "createdAt": "{{createdAt}}",
  "updatedAt": "2026-01-01T00:00:00Z"
}

### 2.3 再次获取设置 (验证更新是否生效)
GET {{baseUrl}}/settings
Authorization: Bearer {{accessToken}}

> {%
    client.test("Theme is updated", function () {
        client.assert(response.body.theme === "DARK", "Theme should be DARK");
    });
%}