@baseUrl = http://localhost:8080
@email = user@example.com
@password = password123
@newPassword = newPassword123
@name = Alice

### 1.1 用户注册
# ==========================================
# 1. 注册与登录流程
# ==========================================
POST {{baseUrl}}/auth/sign-up/email
Content-Type: application/json

{
  "email": "{{email}}",
  "name": "{{name}}",
  "password": "{{password}}"
}

### 验证邮箱
POST {{baseUrl}}/auth/email-otp/verify-email
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "533828"
}

### 1.2 用户登录 (自动捕获 Token)
POST {{baseUrl}}/auth/sign-in/email
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
    client.log("Access Token captured: " + response.body.accessToken);
%}

### 2.1 获取当前用户信息 (需登录)
# ==========================================
# 2. 用户信息与鉴权测试
# ==========================================
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### 2.2 刷新 Token (自动更新 Token)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
    client.log("Refreshed Access Token captured");
%}

### 3.1 发送邮箱验证 OTP
# ==========================================
# 3. 邮箱验证流程
# ==========================================
POST {{baseUrl}}/auth/email-otp/send
Content-Type: application/json

{
  "email": "{{email}}",
  "type": "VERIFY_EMAIL"
}

### 3.2 验证邮箱 (需手动填入邮件中的 OTP)
POST {{baseUrl}}/auth/email-otp/verify-email
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "123456"
}

### 3.3 重新发送验证邮件 (需登录)
POST {{baseUrl}}/auth/email-otp/resend-verification
Authorization: Bearer {{accessToken}}

### 4.1 修改密码 (需登录)
# ==========================================
# 4. 密码管理流程
# ==========================================
POST {{baseUrl}}/auth/password/change
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "oldPassword": "{{password}}",
  "newPassword": "{{newPassword}}"
}

### 4.2 发送重置密码 OTP
POST {{baseUrl}}/auth/email-otp/send
Content-Type: application/json

{
  "email": "{{email}}",
  "type": "RESET_PASSWORD"
}

### 4.3 重置密码 (需手动填入 OTP)
POST {{baseUrl}}/auth/email-otp/reset-password
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "717234",
  "password": "{{password}}"
}

### 5.1 登出
# ==========================================
# 5. 登出与销毁
# ==========================================
POST {{baseUrl}}/auth/sign-out
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 5.2 删除账号 (需登录)
# 注意：如果刚才登出了，需要重新执行 1.2 登录获取 Token
DELETE {{baseUrl}}/auth/account
Authorization: Bearer {{accessToken}}